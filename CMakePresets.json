{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "x64 Debug",
      "description": "Target Windows x64 Debug with MSVC and Qt 6.8.2",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.8.2/msvc2022_64"
      },
      "environment": {
        "PATH": "D:/Qt/6.8.2/msvc2022_64/bin;$penv{PATH}",
        "QTFRAMEWORK_BYPASS_LICENSE_CHECK": "1"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "x64 Release",
      "description": "Target Windows x64 Release with MSVC and Qt 6.8.2",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.8.2/msvc2022_64"
      },
      "environment": {
        "PATH": "D:/Qt/6.8.2/msvc2022_64/bin;$penv{PATH}",
        "QTFRAMEWORK_BYPASS_LICENSE_CHECK": "1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "x64 Debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "displayName": "x64 Release",
      "configurePreset": "windows-x64-release"
    }
  ]
}
